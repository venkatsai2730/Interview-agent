# Azure AD credentials (required)
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# Recall.ai (required)
RECALL_API_KEY=your-recall-api-key
# Recall.ai region — us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1
RECALL_REGION=ap-northeast-1

# Sarvam AI (required) - unified STT, TTS, and LLM provider
# Get your API key at https://dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key

# Alternative LLM providers (optional — for better conversation quality)
# Set one of these to use a stronger LLM while keeping Sarvam STT/TTS
# Then select the model in the UI when creating a session (e.g., gpt-4o-mini, gemini-2.0-flash)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# OpenRouter (recommended — access Gemini, GPT, Claude through one API)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Cloud / Vertex AI (optional — for Gemini 2.5 via Vertex AI)
# Uses gcloud auth (no API key needed). Run: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=ai-dev-environment-minfy
GOOGLE_CLOUD_LOCATION=us-central1

# Deepgram (optional — better English STT when using Gemini/GPT)
# Get your API key at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Email delivery (required)
RESEND_API_KEY=your-resend-api-key

# Microsoft Teams Bot Framework (required)
TEAMS_BOT_APP_ID=your-teams-bot-app-id
TEAMS_BOT_APP_PASSWORD=your-teams-bot-app-password

# Database (required)
# Example: postgresql://vero:vero@db:5432/vero
DATABASE_URL=postgresql://vero:vero@db:5432/vero

# AWS (required for Phone channel - Nova Sonic via LiveKit)
# On EC2, boto3 uses the instance IAM role automatically
AWS_REGION=us-east-1

# AWS profile for local dev only (optional)
# On EC2, omit this — boto3 uses the instance IAM role automatically
AWS_PROFILE=default

# Server port (optional, default 8000)
PORT=8000

# Public webhook URL (ngrok or production URL — no trailing slash)
# Update this whenever ngrok restarts (free plan changes URL on restart)
WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app

# Twilio (required for phone call channel)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Twilio MCP Mode (optional, default: true)
# true  = Use MCP server (JSON-RPC over stdio) - recommended
# false = Use direct Twilio REST API
TWILIO_MCP_ENABLED=true

# LiveKit (required for LiveKit phone channel — better latency than Twilio Media Streams)
# Sign up at https://cloud.livekit.io — free tier available
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
# SIP trunk ID — created in LiveKit Cloud dashboard after linking your Twilio number
# See: https://docs.livekit.io/sip/quickstarts/configuring-sip-twilio/
LIVEKIT_SIP_TRUNK_ID=ST_xxxxxxxxxxxx

# API Authentication (required)
# Bearer token for protecting API endpoints (generate a secure random string)
API_TOKEN=your-secure-api-token-here

# Redis (required for multi-instance deployments)
# Used for cross-instance pipeline registry
# Example: redis://localhost:6379/0 or redis://redis:6379/0 (Docker)
REDIS_URL=redis://localhost:6379/0

# Recall.ai Webhook Secret (optional in dev, required in production)
# Used to verify webhook signatures from Recall.ai
# Get this from your Recall.ai dashboard webhook settings
RECALL_WEBHOOK_SECRET=
